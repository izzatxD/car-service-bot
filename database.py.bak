async def get_overdue_orders(master_id: int) -> list[dict]:
    """Ustaning 3 kundan oshgan, lekin hali topshirilmagan ishlarini olish."""
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        query = """
            SELECT * FROM orders 
            WHERE master_id IN (SELECT telegram_id FROM masters WHERE telegram_id = ? OR parent_id = ?) 
              AND status != 'topshirildi' 
              AND status != 'bekor_qilindi'
              AND created_at <= datetime('now', '-3 days', 'localtime')
            ORDER BY created_at ASC
        """
        cursor = await db.execute(query, (master_id, master_id))
        rows = await cursor.fetchall()
        return [dict(row) for row in rows]

async def get_weekly_history(master_id: int) -> list[dict]:
    """Oxirgi 7 kundagi hamma statusdagi buyurtmalarni olish."""
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        query = """
            SELECT * FROM orders 
            WHERE master_id IN (SELECT telegram_id FROM masters WHERE telegram_id = ? OR parent_id = ?) 
              AND created_at >= datetime('now', '-7 days', 'localtime')
            ORDER BY created_at DESC
        """
        cursor = await db.execute(query, (master_id, master_id))
        rows = await cursor.fetchall()
        return [dict(row) for row in rows]

async def get_all_orders(master_id: int) -> list[dict]:
    """Ustaning barcha mijozlarini (tarix uchun) chiqarib berish."""
    async with aiosqlite.connect(DB_PATH) as db:
