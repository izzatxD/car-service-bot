import aiosqlite
import os
from datetime import datetime, timezone, timedelta
import csv
import openpyxl

from config import DATABASE_PATH as DB_PATH

# ─── Toshkent vaqti (UTC+5) ───────────────────
TZ_UZB = timezone(timedelta(hours=5))

def now_local() -> str:
    """Hozirgi vaqtni Toshkent zonasida qaytaradi: '2026-03-01 00:26:00'"""
    return datetime.now(TZ_UZB).strftime("%Y-%m-%d %H:%M:%S")

def fmt_dt(raw: str | None) -> str:
    """Bazadagi sana/vaqt qatorini chiroyli ko'rinishga keltiradi."""
    if not raw:
        return "—"
    try:
        dt = datetime.fromisoformat(raw)
        return dt.strftime("%d.%m.%Y %H:%M")
    except Exception:
        return raw

async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        # Ustalar jadvali
        await db.execute("""
            CREATE TABLE IF NOT EXISTS masters (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                telegram_id INTEGER UNIQUE,
                full_name TEXT,
                username TEXT,
                phone TEXT DEFAULT '',
                workshop_name TEXT DEFAULT '',
                address TEXT DEFAULT NULL,
                reminder_time TEXT DEFAULT '09:00',
                reminders_enabled INTEGER DEFAULT 0,
                default_warranty_days INTEGER DEFAULT 0,
                is_active INTEGER DEFAULT 1,
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP
            )
        """)
        # Eski DB uchun yangi ustunni qo'shish (xatolikni e'tiborsiz qoldirish)
        try:
            await db.execute("ALTER TABLE masters ADD COLUMN reminders_enabled INTEGER DEFAULT 0")
        except Exception:
            pass
        try:
            await db.execute("ALTER TABLE orders ADD COLUMN mileage TEXT DEFAULT ''")
        except Exception:
            pass
        try:
            await db.execute("ALTER TABLE orders ADD COLUMN next_service_date DATE")
        except Exception:
            pass
        try:
            await db.execute("ALTER TABLE masters ADD COLUMN role TEXT DEFAULT 'boss'")
        except Exception:
            pass
        try:
            await db.execute("ALTER TABLE masters ADD COLUMN branch_name TEXT DEFAULT ''")
        except Exception:
            pass
        await db.execute("""
            CREATE TABLE IF NOT EXISTS orders (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                master_id INTEGER,
                client_name TEXT NOT NULL,
                client_phone TEXT NOT NULL,
                car_model TEXT NOT NULL,
                car_number TEXT DEFAULT '',
                problem TEXT NOT NULL,
                car_condition TEXT NOT NULL,
                price REAL NOT NULL,
                cost REAL DEFAULT 0,
                warranty TEXT NOT NULL,
                warranty_until DATE,
                next_service_date DATE,
                security_code TEXT DEFAULT '',
                status TEXT DEFAULT 'qabul_qilindi',
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                completed_at DATETIME,
                payment_method TEXT DEFAULT 'naqd',
                paid_amount REAL DEFAULT 0
            )
        """)
        await db.commit()

# ═══════════════════════════════════════════════
#  USTALAR (MASTERS) LOGIKASI
# ═══════════════════════════════════════════════

async def add_master(telegram_id: int, full_name: str | None = None, username: str | None = None) -> bool:
    """Yangi ustani qo'shish yoki ma'lumotlarini yangilash."""
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute(
                """INSERT INTO masters (telegram_id, full_name, username, is_active) 
                   VALUES (?, ?, ?, 1) 
                   ON CONFLICT(telegram_id) DO UPDATE SET 
                   full_name = COALESCE(?, masters.full_name),
                   username = COALESCE(?, masters.username),
                   is_active = 1""", 
                (telegram_id, full_name, username, full_name, username)
            )
            await db.commit()
            return True
        except Exception:
            return False

async def get_master(telegram_id: int) -> dict | None:
    """Ustani ID bo'yicha olish."""
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cursor = await db.execute("SELECT * FROM masters WHERE telegram_id = ?", (telegram_id,))
        row = await cursor.fetchone()
        return dict(row) if row else None

async def block_master(telegram_id: int):
    """Ustani bloklash."""
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("UPDATE masters SET is_active = 0 WHERE telegram_id = ?", (telegram_id,))
        await db.commit()

async def get_all_masters() -> list[dict]:
    """Barcha ustalarni ro'yxatini olish."""
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cursor = await db.execute("SELECT * FROM masters ORDER BY created_at DESC")
        rows = await cursor.fetchall()
        return [dict(row) for row in rows]

async def update_master_info(telegram_id: int, phone: str = "", workshop_name: str = "") -> bool:
    """Ustaning ixtiyoriy kontakt ma'lumotlarini yangilash (PDF uchun)."""
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute(
                "UPDATE masters SET phone = ?, workshop_name = ? WHERE telegram_id = ?",
                (phone.strip(), workshop_name.strip(), telegram_id)
            )
            await db.commit()
            return True
        except Exception:
            return False

async def get_workers(parent_id: int) -> list[dict]:
    """Boshliqning barcha shogirdlarini (ishchilarni) olish."""
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        cursor = await db.execute("SELECT * FROM masters WHERE parent_id = ? ORDER BY created_at DESC", (parent_id,))
        rows = await cursor.fetchall()
        return [dict(row) for row in rows]

async def get_branches(master_id: int) -> list[str]:
    """Boshliq va uning shogirdlariga tegishli (mavjud) barcha filiallarni olish."""
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT DISTINCT branch_name FROM masters WHERE (telegram_id = ? OR parent_id = ?) AND branch_name != '' AND branch_name IS NOT NULL", 
            (master_id, master_id)
        )
        rows = await cursor.fetchall()
        return [r[0] for r in rows if r[0]]

async def add_worker(parent_id: int, telegram_id: int, full_name: str, phone: str, branch_name: str) -> bool:
    """Boshliq o'ziga yangi shogird qo'shishi."""
    async with aiosqlite.connect(DB_PATH) as db:
        try:
            await db.execute(
                """INSERT INTO masters (telegram_id, full_name, phone, role, parent_id, branch_name, is_active) 
                   VALUES (?, ?, ?, 'worker', ?, ?, 1)""", 
                (telegram_id, full_name, phone, parent_id, branch_name)
            )
            await db.commit()
            return True
        except Exception:
            return False

async def update_master_settings(telegram_id: int, **kwargs) -> bool:
    """Ustaning o'zgartirilgan sozlamalarini (settings) bazaga yozish."""
    valid_keys = ['workshop_name', 'address', 'phone', 'reminder_time', 'default_warranty_days', 'reminders_enabled']
    updates = []
    params = []
    
    for key, value in kwargs.items():
        if key in valid_keys:
            updates.append(f"{key} = ?")
            params.append(value)
            
    if not updates:
        return False
        
    async with aiosqlite.connect(DB_PATH) as db:
        sql = f"UPDATE masters SET {', '.join(updates)} WHERE telegram_id = ?"
        params.append(telegram_id)
        await db.execute(sql, tuple(params))
        await db.commit()
        return True

