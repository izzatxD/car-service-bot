async def process_client_phone(message: types.Message, state: FSMContext):
    await state.update_data(client_phone=message.text.strip())
    await state.set_state(NewOrder.car_model)
    await message.answer("🚗 Mashina rusumini tanlang yoki nomini yozing (masalan: Chevrolet Cobalt):", reply_markup=car_models_kb())

